def describe_features(df, feature_names):
    summary = df[feature_names].agg(['mean', 'median', 'std', 'max', 'min']).T
    summary = summary.rename(columns={
        'mean': 'Mean',
        'median': 'Median',
        'std': 'Standard Deviation',
        'max': 'Max',
        'min': 'Min'
    })
    return summary

